# Copy this file to .env and fill in ONE key.
VISION_PROVIDER=anthropic          # anthropic or gemini
VISION_MODEL=claude-sonnet-5-5     # for gemini use e.g. gemini-2.5-flash
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MOCK_VISION=0                      # 1 = fake AI answers, to test without any key
RED_MIN_PIXELS=30                  # lower = flags more, higher = flags less
